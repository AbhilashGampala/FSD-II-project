{
  "name": "vit-campus-placement-tracker",
  "version": "1.0.0",
  "description": "Campus Placement Tracker for Vishnu Institute of Technology (VIT), Bhimavaram",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}